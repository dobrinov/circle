{
  "manifest_version": 3,
  "name": "Circle",
  "version": "1.0",
  "description": "Tells Circle which tab each page is in, so other extensions' popups know the current tab.",
  "key": "",
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["cs.js"], "run_at": "document_start" }
  ]
}
